<% content_for :title, @user.name %>

<header class="mb-8">
  <h1 class="text-3xl font-bold"><%= @user.name %></h1>
  <p class="text-sm text-slate-500 mt-1"><%= @user.email %></p>
</header>

<%= render "section",
      title: "Events created",
      upcoming: @upcoming_created,
      past: @past_created %>

<%= render "section",
      title: "Events attending",
      upcoming: @upcoming_attended,
      past: @past_attended %>

<% if current_user == @user %>
  <%= render "section",
        title: "Invited to",
        upcoming: @upcoming_invited,
        past: @past_invited %>
<% end %>
