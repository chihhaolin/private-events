<div class="max-w-md mx-auto">
  <div class="bg-white rounded-xl border border-slate-200 shadow-sm p-6 sm:p-8">
    <h2 class="text-2xl font-bold mb-6">Log in</h2>

    <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { data: { turbo: false }, class: "space-y-4" }) do |f| %>
      <div>
        <%= f.label :email, class: "block text-sm font-medium text-slate-700 mb-1" %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email",
              class: "w-full px-3 py-2 rounded-md border border-slate-300 focus:border-indigo-400 focus:ring-1 focus:ring-indigo-400 focus:outline-none" %>
      </div>

      <div>
        <%= f.label :password, class: "block text-sm font-medium text-slate-700 mb-1" %>
        <%= f.password_field :password, autocomplete: "current-password",
              class: "w-full px-3 py-2 rounded-md border border-slate-300 focus:border-indigo-400 focus:ring-1 focus:ring-indigo-400 focus:outline-none" %>
      </div>

      <% if devise_mapping.rememberable? %>
        <label class="flex items-center gap-2 text-sm text-slate-700">
          <%= f.check_box :remember_me, class: "h-4 w-4 rounded border-slate-300 text-indigo-600 focus:ring-indigo-500" %>
          Remember me
        </label>
      <% end %>

      <%= f.submit "Log in",
            class: "w-full px-4 py-2 rounded-md bg-indigo-600 text-white text-sm font-medium hover:bg-indigo-700" %>
    <% end %>
  </div>

  <div class="mt-4 text-center text-sm text-slate-600">
    <%= render "devise/shared/links" %>
  </div>
</div>
