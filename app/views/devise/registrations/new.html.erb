<div class="max-w-md mx-auto">
  <div class="bg-white rounded-xl border border-slate-200 shadow-sm p-6 sm:p-8">
    <h2 class="text-2xl font-bold mb-6">Sign up</h2>

    <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { data: { turbo: false }, class: "space-y-4" }) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>

      <div>
        <%= f.label :name, class: "block text-sm font-medium text-slate-700 mb-1" %>
        <%= f.text_field :name, autofocus: true, autocomplete: "name",
              class: "w-full px-3 py-2 rounded-md border border-slate-300 focus:border-indigo-400 focus:ring-1 focus:ring-indigo-400 focus:outline-none" %>
      </div>

      <div>
        <%= f.label :email, class: "block text-sm font-medium text-slate-700 mb-1" %>
        <%= f.email_field :email, autocomplete: "email",
              class: "w-full px-3 py-2 rounded-md border border-slate-300 focus:border-indigo-400 focus:ring-1 focus:ring-indigo-400 focus:outline-none" %>
      </div>

      <div>
        <%= f.label :password, class: "block text-sm font-medium text-slate-700 mb-1" %>
        <%= f.password_field :password, autocomplete: "new-password",
              class: "w-full px-3 py-2 rounded-md border border-slate-300 focus:border-indigo-400 focus:ring-1 focus:ring-indigo-400 focus:outline-none" %>
        <% if @minimum_password_length %>
          <p class="mt-1 text-xs text-slate-500"><%= @minimum_password_length %> characters minimum.</p>
        <% end %>
      </div>

      <div>
        <%= f.label :password_confirmation, "Confirm password", class: "block text-sm font-medium text-slate-700 mb-1" %>
        <%= f.password_field :password_confirmation, autocomplete: "new-password",
              class: "w-full px-3 py-2 rounded-md border border-slate-300 focus:border-indigo-400 focus:ring-1 focus:ring-indigo-400 focus:outline-none" %>
      </div>

      <%= f.submit "Sign up",
            class: "w-full px-4 py-2 rounded-md bg-indigo-600 text-white text-sm font-medium hover:bg-indigo-700" %>
    <% end %>
  </div>

  <div class="mt-4 text-center text-sm text-slate-600">
    <%= render "devise/shared/links" %>
  </div>
</div>
